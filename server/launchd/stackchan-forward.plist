<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>stackchan-forward</string>
  <key>ProgramArguments</key><array>
    <string>__PY__</string>
    <string>__REPO__/server/tailnet_proxy.py</string>
    <string>8080</string>
    <string>__BOARD_IP__</string>
    <string>80</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/stackchan-forward.log</string>
  <key>StandardErrorPath</key><string>/tmp/stackchan-forward.log</string>
</dict></plist>
